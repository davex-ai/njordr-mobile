{
  "expo": {
    "name": "Njörðr",
    "slug": "njordr",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "84e0b715-460f-403c-b806-037db67c3717"
      }
    },    
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "njordr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.njordr.app"
    },
    "android": {
      "package": "com.njordr.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#133742"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-system-ui"
    ]
  }
}