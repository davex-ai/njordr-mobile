# Same Supabase project as the web app (Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the deployed Njörðr web app (no trailing slash). The mobile app calls
# `${EXPO_PUBLIC_API_URL}/api/checkout` with the user's Supabase token to place orders + send the Brevo email.
# e.g. https://njordr.vercel.app   (on a real phone, localhost won't work, use your LAN IP or the deployed URL)
EXPO_PUBLIC_API_URL=

# Display-only exchange rate for ₦ prices (same as the web app).
EXPO_PUBLIC_USD_NGN=1500

# Optional: Unsplash access key for the home hero photos (falls back to product photos if empty).
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=
